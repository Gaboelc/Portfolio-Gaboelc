---
import MainLayout from '../layouts/MainLayout.astro';
import PrintIcon from '../icons/PrintIcon.astro';
import {
  profile,
  experience,
  education,
  certifications,
  skillGroups,
  languages,
} from '../data/cv';
import { t, langOf, formatMonth, formatPeriod } from '../i18n';

const lang = langOf(Astro.url);
const copy = {
  en: {
    title: 'CV — Gabriel León Castro, Analytics Engineer',
    description:
      'Full CV of Gabriel León Castro: BI at Vivo Gaming, Analytics Engineering at Hakkōda (an IBM company), data roles at Intel and DHL, a Data Science degree and SnowPro Core certification.',
    formula: '=PRINT("cv", "letter")',
    download: 'Download PDF',
    profile: 'Profile',
    experience: 'Experience',
    education: 'Education',
    certifications: 'Certifications',
    skills: 'Technical Skills',
    languages: 'Languages',
    issued: 'Issued',
    validThrough: 'Valid through',
  },
  es: {
    title: 'CV — Gabriel León Castro, Analytics Engineer',
    description:
      'CV completo de Gabriel León Castro: BI en Vivo Gaming, Analytics Engineering en Hakkōda (una empresa de IBM), puestos de datos en Intel y DHL, bachillerato en Ciencia de Datos y certificación SnowPro Core.',
    formula: '=IMPRIMIR("cv"; "carta")',
    download: 'Descargar PDF',
    profile: 'Perfil',
    experience: 'Experiencia',
    education: 'Educación',
    certifications: 'Certificaciones',
    skills: 'Habilidades técnicas',
    languages: 'Idiomas',
    issued: 'Emitida en',
    validThrough: 'vigente hasta',
  },
}[lang];

const contacts = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'linkedin.com/in/gaboelc', href: profile.links.linkedin },
  { label: 'github.com/Gaboelc', href: profile.links.github },
  { label: 'gaboelc.dev', href: profile.links.website },
];
---

<MainLayout title={copy.title} description={copy.description}>
  <article data-cell data-formula={copy.formula} class="cv mx-4 my-[calc(var(--row)*2)] border border-ink bg-paper px-5 py-8 md:mx-auto md:max-w-[850px] md:px-10 md:py-12">
    <!-- Header -->
    <header class="cv-head flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-6 border-b border-ink">
      <div>
        <h1 class="cv-name font-pixel text-[44px] leading-none text-ink md:text-[66px]">
          {profile.name}
        </h1>
        <p class="cv-role mt-2 text-xl font-medium text-accent-ink md:text-2xl">
          {profile.role}
        </p>
        <p class="cv-muted text-sm text-muted mt-1">{profile.location}</p>
      </div>

      <button
        type="button"
        id="print-cv"
        class="no-print inline-flex shrink-0 items-center gap-2 whitespace-nowrap self-start border border-ink px-4 py-2 font-mono text-sm transition-colors hover:bg-ink hover:text-paper md:self-auto">
        <PrintIcon class="w-5 h-5" />
        {copy.download}
      </button>
    </header>

    <!-- Contact -->
    <ul class="cv-contact flex flex-wrap gap-x-5 gap-y-1 mt-4 text-sm text-muted">
      {
        contacts.map(({ label, href }) => (
          <li>
            <a href={href} class="hover:text-accent-ink transition-colors duration-200">
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Summary -->
    <section class="cv-section mt-8">
      <h2 class="cv-h2">{copy.profile}</h2>
      <p class="cv-body text-ink/85 leading-relaxed">{t(profile.summary, lang)}</p>
    </section>

    <!-- Experience -->
    <section class="cv-section mt-8">
      <h2 class="cv-h2">{copy.experience}</h2>
      <ol class="flex flex-col gap-6">
        {
          experience.map(({ start, end, role, company, location, highlights }) => (
            <li class="cv-entry">
              <div class="cv-entry-head">
                <h3 class="cv-h3 text-lg font-semibold text-ink">
                  {role} <span class="cv-accent text-accent-ink">· {company}</span>
                </h3>
                <p class="cv-muted cv-period text-sm text-muted">
                  {formatPeriod(start, end, lang)} · {t(location, lang)}
                </p>
              </div>
              <ul class="cv-bullets mt-2 flex flex-col gap-1.5 text-sm md:text-base text-ink/85">
                {highlights.map((highlight) => (
                  <li class="pl-4 relative before:content-['▪'] before:absolute before:left-0 before:text-accent">
                    {t(highlight, lang)}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Education & Certifications -->
    <div class="cv-grid grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
      <section class="cv-section">
        <h2 class="cv-h2">{copy.education}</h2>
        <ul class="flex flex-col gap-4">
          {
            education.map(({ title, place, start, end, location }) => (
              <li class="cv-entry">
                <h3 class="cv-h3 text-base font-semibold text-ink">{t(title, lang)}</h3>
                <p class="cv-accent text-sm text-accent-ink">{place}</p>
                <p class="cv-muted text-sm text-muted">
                  {formatPeriod(start, end, lang)} · {location}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-section">
        <h2 class="cv-h2">{copy.certifications}</h2>
        <ul class="flex flex-col gap-4">
          {
            certifications.map(({ title, place, issued, expires }) => (
              <li class="cv-entry">
                <h3 class="cv-h3 text-base font-semibold text-ink">{title}</h3>
                <p class="cv-accent text-sm text-accent-ink">{place}</p>
                <p class="cv-muted text-sm text-muted">
                  {copy.issued} {formatMonth(issued, lang)} · {copy.validThrough} {formatMonth(expires, lang)}
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Skills -->
    <section class="cv-section mt-8">
      <h2 class="cv-h2">{copy.skills}</h2>
      <ul class="flex flex-col gap-2">
        {
          skillGroups.map(({ title, items }) => (
            <li class="cv-skill text-sm md:text-base text-ink/85">
              <span class="cv-accent font-semibold text-ink">{t(title, lang)}:</span>{' '}
              {items.map(({ name }) => t(name, lang)).join(', ')}
            </li>
          ))
        }
        <li class="cv-skill text-sm md:text-base text-ink/85">
          <span class="cv-accent font-semibold text-ink">{copy.languages}:</span>{' '}
          {languages.map(({ name, level }) => `${t(name, lang)} (${t(level, lang)})`).join(', ')}
        </li>
      </ul>
    </section>
  </article>
</MainLayout>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv-h2 {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--muted));
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgb(var(--ink) / 0.2);
  }

  /* Print: black on white, and compressed hard so the whole CV lands on one
     A4 page. Heights were measured against the 1017px usable page height;
     see the entry head going flex, which saves a full line per role. */
  @media print {
    /* Sized for US Letter, which is 18mm shorter than A4 — fitting Letter
       means it also fits A4, not the other way round. */
    @page {
      margin: 1.1cm;
    }

    :global(body) {
      min-height: 0 !important;
    }

    :global(main) {
      padding: 0 !important;
      max-width: none !important;
    }

    .cv,
    .cv-body,
    .cv-h3,
    .cv-bullets,
    .cv-skill {
      color: #111 !important;
    }

    .cv {
      width: 100% !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      background: none !important;
    }

    /* Issuer lines under education and certifications read at body size. */
    .cv-grid .cv-accent {
      font-size: 8.4pt !important;
      font-weight: 600;
    }

    /* Header */
    .cv-head {
      display: flex !important;
      flex-direction: row !important;
      align-items: baseline !important;
      gap: 0.6rem !important;
      border-bottom: 1.5pt solid #111 !important;
      padding-bottom: 0.25rem !important;
    }

    .cv-name {
      font-family: 'Schibsted Grotesk', sans-serif !important;
      font-weight: 600 !important;
      font-size: 19pt !important;
      line-height: 1.1 !important;
    }

    .cv-role {
      font-size: 11pt !important;
      color: #111 !important;
      margin-top: 0 !important;
    }

    .cv-head .cv-muted {
      margin-top: 0 !important;
    }

    .cv-contact {
      margin-top: 0.3rem !important;
      gap: 0 0.9rem !important;
      font-size: 8pt !important;
    }

    /* Section headings */
    .cv-h2 {
      color: #111;
      font-size: 8.5pt;
      letter-spacing: 0.12em;
      border-bottom: 0.5pt solid #999;
      padding-bottom: 0.12rem;
      margin-bottom: 0.28rem;
    }

    .cv-section {
      margin-top: 0.45rem !important;
    }

    .cv-section :global(.flex),
    .cv-section :global(ol),
    .cv-section :global(ul) {
      gap: 0.25rem !important;
    }

    /* Role + period share one line instead of stacking. */
    .cv-entry-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.8rem;
    }

    .cv-period {
      white-space: nowrap;
      text-align: right;
    }

    .cv-h3 {
      font-size: 9.5pt !important;
      line-height: 1.25 !important;
    }

    .cv-muted,
    .cv-contact,
    .cv-contact a {
      color: #444 !important;
      font-size: 8pt !important;
    }

    .cv-accent {
      color: #111 !important;
    }

    .cv-body,
    .cv-bullets,
    .cv-skill {
      font-size: 8.4pt !important;
      line-height: 1.28 !important;
    }

    .cv-bullets {
      margin-top: 0.1rem !important;
      gap: 0.05rem !important;
    }

    .cv-bullets li {
      padding-left: 0.6rem !important;
    }

    .cv-bullets li::before {
      color: #111 !important;
    }

    /* The print viewport is the paper width (~711px), which is below
       Tailwind's md breakpoint, so md:grid-cols-2 never fires and these two
       would stack. The columns are set explicitly here instead. */
    .cv-grid {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      align-items: start !important;
      margin-top: 0.45rem !important;
      gap: 0 1.5rem !important;
    }

    /* An entry splitting across a page break reads as two half-jobs, but the
       section as a whole must stay breakable or it gets pushed to page two. */
    .cv-entry {
      break-inside: avoid;
    }
  }
</style>
