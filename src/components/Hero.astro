---
import SectionLabel from './SectionLabel.astro';
import QueryBlock from './QueryBlock.astro';
import { profile, languages } from '../data/cv';

// The name is drawn in pixel type and "parsed" into place from CSV noise. The
// letters are real text from the start; the script only scrambles them, so
// without it (or with motion reduced) the name simply reads.
const nameLines = ['Gabriel', 'León Castro'];

const record = [
  { key: 'location', value: `${profile.location} · UTC−6` },
  { key: 'speaks', value: languages.map(({ name, level }) => `${name} (${level})`).join(' · ') },
  { key: 'worked at', value: 'Vivo Gaming · Hakkōda (IBM) · Intel · DHL' },
];
---

<section
  id="top"
  data-cell
  data-formula={'=PARSE("gabriel_leon.csv")'}
  class="px-4 pb-[calc(var(--row)*3)] pt-[var(--row)] md:px-0">
  <h1 class="sr-only">{profile.name}, analytics engineer</h1>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 md:px-3">
    <SectionLabel index="00" type="csv" file="gabriel_leon.csv" as="p" />
    <span data-parse-status class="font-mono text-xs text-muted">1 row · 3 fields · utf-8</span>
  </div>

  <div
    data-decode
    class="mt-[var(--row)] font-pixel text-[clamp(33px,11.5vw,44px)] leading-[0.95] tracking-[-0.02em] sm:text-[66px] md:px-3 md:text-[88px] lg:text-[132px] xl:text-[176px]"
    aria-hidden="true">
    <div class="flex items-end">
      {[...nameLines[0]].map((ch) => <span data-ch={ch}>{ch}</span>)}
      <span class="group relative ml-[0.35em] inline-block h-[0.8em] w-[0.8em] shrink-0 self-center border border-ink bg-paper">
        <img
          class="pixelated absolute inset-0 h-full w-full"
          src="/images/gabriel-dither.png"
          alt=""
          width="120"
          height="120"
        />
        <img
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          src="/images/gabriel-288.webp"
          alt=""
          width="288"
          height="288"
          loading="lazy"
        />
      </span>
    </div>
    <div class="whitespace-nowrap">
      {[...nameLines[1]].map((ch) => (ch === ' ' ? ' ' : <span data-ch={ch}>{ch}</span>))}
    </div>
  </div>

  <div class="mt-[calc(var(--row)*2)] gap-y-[var(--row)] md:grid md:grid-cols-12">
    <div class="md:col-span-6 md:px-3 xl:col-span-5">
      <p class="max-w-[34ch] text-[1.375rem] leading-[1.3] md:text-[1.625rem]">
        Analytics engineer. I work between the warehouse and the business:
        SQL in Snowflake and Redshift, star-schema semantic models, and the
        Power BI reports on top.
      </p>

      <dl class="mt-[var(--row)] grid grid-cols-[6.5rem_minmax(0,1fr)] border border-ink bg-paper font-mono text-[13px]">
        <dt class="border-b border-r border-ink/15 px-3 py-2 text-muted">status</dt>
        <dd class="flex items-center gap-2 border-b border-ink/15 px-3 py-2">
          <span class="inline-block h-2 w-2 shrink-0 bg-accent" aria-hidden="true"></span>
          Open to remote analytics engineering roles
        </dd>

        {
          record.map(({ key, value }) => (
            <>
              <dt class="border-b border-r border-ink/15 px-3 py-2 text-muted">{key}</dt>
              <dd class="border-b border-ink/15 px-3 py-2">{value}</dd>
            </>
          ))
        }

        <dt class="border-r border-ink/15 px-3 py-2 text-muted">email</dt>
        <dd class="flex flex-wrap items-center justify-between gap-2 px-3 py-2">
          <a href={`mailto:${profile.email}`} class="underline decoration-ink/30 underline-offset-4 hover:decoration-accent">
            {profile.email}
          </a>
          <button
            type="button"
            data-copy={profile.email}
            class="js-only border border-ink px-2 py-0.5 text-[11px] uppercase tracking-[0.08em] transition-colors hover:bg-ink hover:text-paper">
            Copy
          </button>
        </dd>
      </dl>
    </div>

    <div class="mt-[calc(var(--row)*2)] md:col-span-6 md:mt-0 md:px-3 xl:col-start-7">
      <QueryBlock />
    </div>
  </div>
</section>

<script>
  // Copy the address, and say so where the button was.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘/Ctrl+C';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  });

  // Parse the name out of CSV noise: every letter cycles through delimiter and
  // digit glyphs, then settles left to right like a reader scanning a row.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const letters = [...document.querySelectorAll<HTMLElement>('[data-decode] [data-ch]')];
  const status = document.querySelector<HTMLElement>('[data-parse-status]');

  if (!reduced && letters.length) {
    const noise = ',;"|01234567890.,;';
    const start = performance.now();
    const settleAt = letters.map((_, i) => 180 + i * 55 + Math.random() * 90);
    const finalText = status?.textContent ?? '';
    if (status) status.textContent = 'parsing…';

    // Noise swaps every ~50ms rather than every frame: fast enough to read as
    // motion, slow enough not to strobe.
    let lastSwap = -Infinity;
    const tick = (now: number) => {
      const t = now - start;
      const swap = t - lastSwap > 50;
      if (swap) lastSwap = t;
      let pending = 0;
      letters.forEach((el, i) => {
        if (t >= settleAt[i]) {
          el.textContent = el.dataset.ch ?? '';
        } else {
          pending++;
          if (swap) el.textContent = noise[Math.floor(Math.random() * noise.length)];
        }
      });
      if (pending) {
        requestAnimationFrame(tick);
      } else if (status) {
        status.textContent = finalText;
      }
    };
    requestAnimationFrame(tick);
  }
</script>
