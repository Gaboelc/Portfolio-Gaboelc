---
import Tittle from "./Tittle.astro";
import EmailIcon from "../icons/EmailIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import GitHubIcon from "../icons/GitHubIcon.astro";

// One surface treatment for all three. The brand colours - LinkedIn blue in
// particular - were the only saturated thing on the page and shouted next to
// the accent.
const channels = [
  {
    href: "mailto:gabrielleon917@gmail.com",
    label: "Email",
    Icon: EmailIcon,
    external: false,
  },
  {
    href: "https://www.linkedin.com/in/gaboelc/",
    label: "LinkedIn",
    Icon: LinkedInIcon,
    external: true,
  },
  {
    href: "https://github.com/Gaboelc",
    label: "GitHub",
    Icon: GitHubIcon,
    external: true,
  },
];
---

<div class="text-center">
  <Tittle title="Connect With Me" />

  <div class="flex flex-wrap justify-center gap-6 md:gap-8 mt-8">
    {
      channels.map(({ href, label, Icon, external }) => (
        <a
          href={href}
          aria-label={label}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
          class="group flex flex-col items-center justify-center gap-2 w-24 h-24 md:w-28 md:h-28 rounded-lg border border-white/10 bg-white/5 text-gray-300 transition-all duration-300 hover:border-accent/40 hover:text-white hover:scale-105">
          <Icon class="w-8 h-8 md:w-9 md:h-9" />
          <span class="text-xs md:text-sm">{label}</span>
        </a>
      ))
    }
  </div>
</div>
