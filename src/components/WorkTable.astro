---
import SectionLabel from './SectionLabel.astro';
import { experience, formatMonth } from '../data/cv';

// The work history as data: one table, viewable formatted or as the raw CSV it
// would export to, and downloadable as exactly that file.
const columns = ['start', 'end', 'company', 'role', 'location', 'metric'] as const;

const field = (value = '') => (/[",\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value);
const csv = [
  columns.join(','),
  ...experience.map((row) => columns.map((key) => field(row[key])).join(',')),
].join('\n');

// A BOM so Excel opens the accents (Hakkōda, León) as UTF-8, not mojibake.
const download = `data:text/csv;charset=utf-8,${encodeURIComponent('﻿' + csv)}`;

// For the raw view: delimiters picked out, commas inside quoted fields left
// alone, everything else escaped.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const paint = (line: string) => {
  let out = '';
  let quoted = false;
  for (const ch of line) {
    if (ch === '"') {
      quoted = !quoted;
      out += '<span class="text-muted">"</span>';
    } else if (ch === ',' && !quoted) {
      out += '<span class="text-accent-ink">,</span>';
    } else {
      out += escape(ch);
    }
  }
  return out;
};
const csvLines = csv.split('\n').map(paint);

const desktopCols = 'md:grid-cols-[2.5rem_5.5rem_5.5rem_minmax(0,1.15fr)_minmax(0,1.4fr)_minmax(0,1fr)_2.25rem]';
const short = (yearMonth: string) => formatMonth(yearMonth).replace(/(\w{3})\w*/, '$1');
---

<section
  id="work"
  data-cell
  data-formula={'=IMPORTDATA("work.csv")'}
  class="px-4 py-[calc(var(--row)*2)] md:px-0">
  <div class="flex flex-wrap items-center justify-between gap-3 md:px-3">
    <SectionLabel index="01" type="csv" file="work.csv" />

    <div class="flex items-stretch font-mono text-xs">
      <div class="js-only flex border border-ink" role="tablist" aria-label="View">
        <button type="button" role="tab" data-view="table" aria-selected="true" aria-controls="work-table"
          class="px-3 py-1 aria-selected:bg-ink aria-selected:text-paper">Table</button>
        <button type="button" role="tab" data-view="csv" aria-selected="false" aria-controls="work-csv"
          class="border-l border-ink px-3 py-1 aria-selected:bg-ink aria-selected:text-paper">CSV</button>
      </div>
      <a
        href={download}
        download="gabriel_leon_work.csv"
        class="ml-2 flex items-center gap-1 border border-ink px-3 py-1 transition-colors hover:bg-ink hover:text-paper">
        <span aria-hidden="true">↓</span> Download
      </a>
    </div>
  </div>

  <p class="mt-[var(--row)] max-w-[40ch] text-[1.375rem] leading-[1.3] md:px-3 md:text-[1.625rem]">
    Every role moved me one layer closer to the warehouse: from Excel files and
    dashboards to SQL views and semantic models.
  </p>

  <div class="mt-[var(--row)] border border-ink bg-paper md:mx-3">
    <div id="work-table" role="tabpanel">
      <div class:list={['hidden border-b border-ink bg-ink/5 font-mono text-[11px] uppercase tracking-[0.08em] text-muted md:grid', desktopCols]} aria-hidden="true">
        <span class="border-r border-ink/15 px-2 py-1.5 text-center">#</span>
        {['start', 'end', 'company', 'role', 'metric'].map((h) => (
          <span class="border-r border-ink/15 px-3 py-1.5">{h}</span>
        ))}
        <span></span>
      </div>

      {
        experience.map((row, i) => (
          <details class="group border-b border-ink/15 last:border-b-0" open={i === 0}>
            <summary class:list={['grid cursor-pointer list-none grid-cols-[2rem_minmax(0,1fr)_2rem] items-stretch transition-colors hover:bg-ink/[0.03] [&::-webkit-details-marker]:hidden', desktopCols]}>
              <span class="flex items-start justify-center border-r border-ink/15 py-3 font-mono text-[11px] text-muted md:py-2.5">
                {i + 1}
              </span>

              {/* Phone: one stacked cell. */}
              <span class="px-3 py-3 md:hidden">
                <span class="block font-medium">{row.company}</span>
                <span class="block text-sm">{row.role}</span>
                <span class="mt-1 block font-mono text-xs text-muted">
                  {row.start} → {row.end}{row.metric && <> · <span class="text-ink">{row.metric}</span></>}
                </span>
              </span>

              {/* Desktop: one cell per column. */}
              <span class="hidden border-r border-ink/15 px-3 py-2.5 font-mono text-[13px] tabular-nums md:block">{short(row.start)}</span>
              <span class="hidden border-r border-ink/15 px-3 py-2.5 font-mono text-[13px] tabular-nums md:block">{short(row.end)}</span>
              <span class="hidden border-r border-ink/15 px-3 py-2.5 font-medium md:block">{row.company}</span>
              <span class="hidden border-r border-ink/15 px-3 py-2.5 md:block">{row.role}</span>
              <span class="hidden border-r border-ink/15 px-3 py-2.5 font-mono text-[13px] md:block">
                {row.metric ?? <span class="text-muted">—</span>}
              </span>

              <span class="flex items-start justify-center py-3.5 text-muted md:py-3" aria-hidden="true">
                <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12">
                  <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </summary>

            <div class="border-t border-dashed border-ink/20 py-4 pl-[2rem] pr-4 md:pl-[calc(2.5rem+11rem)] md:pr-12">
              <p class="font-mono text-xs text-muted">{row.location}</p>
              {row.context && <p class="mt-2 max-w-[70ch] text-[15px] italic text-muted">{row.context}</p>}
              <ul class="mt-3 flex max-w-[70ch] flex-col gap-2 text-[15px] leading-relaxed">
                {row.highlights.map((h) => (
                  <li class="relative pl-4 before:absolute before:left-0 before:top-[0.6em] before:h-1.5 before:w-1.5 before:bg-accent">
                    {h}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>

    <div id="work-csv" role="tabpanel" hidden>
      <ol class="overflow-x-auto py-2 font-mono text-[13px] leading-[var(--row)]">
        {
          csvLines.map((line, i) => (
            <li class="flex whitespace-pre">
              <span class="sticky left-0 w-10 shrink-0 select-none border-r border-ink/15 bg-paper pr-2 text-right text-[11px] text-muted">{i + 1}</span>
              <span class="px-3" set:html={line} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#work [data-view]')];
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
    });
  });
</script>
