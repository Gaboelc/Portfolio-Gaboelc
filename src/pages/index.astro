---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Headling from '../components/Headling.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---
<MainLayout title="Gabriel León Castro - Analytics Engineer Portfolio">
  <section class="w-full mx-auto lg:w-[850px] pt-10 pb-16 md:pt-16 md:pb-24">
    <Headling />
  </section>
  <section id="About" class="w-full mx-auto lg:w-[850px] py-12 md:py-16">
    <About />
  </section>
  <section id="Experience" class="w-full mx-auto lg:w-[850px] py-12 md:py-16">
    <Experience />
  </section>
  <section id="Skills" class="w-full mx-auto lg:w-[850px] py-12 md:py-16">
    <Skills />
  </section>
  <section id="Education" class="w-full mx-auto lg:w-[850px] py-12 md:py-16">
    <Education />
  </section>
  <section id="Contact" class="w-full mx-auto lg:w-[850px] py-12 md:py-16">
    <Contact />
  </section>
</MainLayout>
