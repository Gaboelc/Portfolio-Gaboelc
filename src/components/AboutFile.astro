---
import SectionLabel from './SectionLabel.astro';
import FileBadge from './FileBadge.astro';
import { profile, education, certifications } from '../data/cv';
import { t, langOf } from '../i18n';

interface Props {
  index: string;
}

const { index } = Astro.props;
const lang = langOf(Astro.url);

// Written as a Markdown file with its syntax left visible: the headings keep
// their #, the list keeps its dashes. Side projects are the public repos on
// GitHub, named by what they analyse.
const copy = {
  en: {
    formula: '=CONCAT(work, " ", life)',
    file: 'about.md',
    intro:
      "I'm an analytics engineer in San José, Costa Rica. I started out at a technical high school studying computer networking, and did my Data Science degree at LEAD University while already working as a data analyst at Intel.",
    offClock: 'Off the clock',
    datasets: 'I still open datasets nobody asked me to:',
    sideProjects: [
      "Costa Rica's employment data, 2018–2022 (INEC)",
      'Police statistics, 2015–2023',
      "Costa Rica's civil registry",
      'BAC Costa Rica bank transactions',
      'Samsung Health exports',
      '3DMark benchmark runs',
    ],
    onGithub: ["They're on", '.'],
    credentials: 'credentials.csv',
    columns: ['credential', 'when'],
  },
  es: {
    formula: '=CONCAT(trabajo; " "; vida)',
    file: 'sobre_mi.md',
    intro:
      'Soy analytics engineer en San José, Costa Rica. Empecé en un colegio técnico estudiando redes de computadoras, e hice el bachillerato en Ciencia de Datos en LEAD University mientras ya trabajaba como analista de datos en Intel.',
    offClock: 'Fuera del horario',
    datasets: 'Sigo abriendo datasets que nadie me pidió:',
    sideProjects: [
      'Datos de empleo de Costa Rica, 2018–2022 (INEC)',
      'Estadísticas policiales, 2015–2023',
      'El registro civil de Costa Rica',
      'Transacciones bancarias de BAC Costa Rica',
      'Exportaciones de Samsung Health',
      'Corridas de benchmark de 3DMark',
    ],
    onGithub: ['Están en', '.'],
    credentials: 'credenciales.csv',
    columns: ['credencial', 'cuándo'],
  },
}[lang];

const year = (yearMonth: string) => yearMonth.slice(0, 4);
const monthYear = (yearMonth: string) => `${yearMonth.slice(5)}/${yearMonth.slice(0, 4)}`;
const credentials = [
  ...education.map(({ title, place, start, end }) => ({ title: t(title, lang), place, when: `${year(start)}–${year(end)}` })),
  ...certifications.map(({ title, place, issued, expires }) => ({ title, place, when: `${monthYear(issued)} → ${monthYear(expires)}` })),
];

const mark = 'select-none font-mono text-muted';
---

<section
  id="about"
  data-cell
  data-formula={copy.formula}
  class="px-4 py-[calc(var(--row)*2)] md:px-0">
  <div class="md:px-3">
    <SectionLabel index={index} type="md" file={copy.file} />
  </div>

  <div class="mt-[var(--row)] grid gap-[var(--row)] md:grid-cols-12 md:gap-0">
    <article class="border border-ink bg-paper md:col-span-7 md:mx-3">
      <p class="flex items-center gap-2 border-b border-ink px-3 py-1.5 font-mono text-xs">
        <FileBadge type="md" aria-hidden="true" />
        {copy.file}
      </p>

      <div class="px-4 py-5 md:px-6 md:py-6">
        <h3 class="text-[1.625rem] font-medium leading-tight">
          <span class={mark} aria-hidden="true"># </span>{profile.name}
        </h3>
        <p class="mt-4 max-w-[62ch] text-base leading-relaxed md:text-[17px]">
          {copy.intro}
        </p>

        <h4 class="mt-7 text-lg font-medium">
          <span class={mark} aria-hidden="true">## </span>{copy.offClock}
        </h4>
        <p class="mt-3 max-w-[62ch] text-base leading-relaxed md:text-[17px]">
          {copy.datasets}
        </p>
        <ul class="mt-2 flex flex-col gap-1 text-base md:text-[17px]">
          {
            copy.sideProjects.map((item) => (
              <li>
                <span class={mark} aria-hidden="true">- </span>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-base md:text-[17px]">
          {copy.onGithub[0]}
          <a href={profile.links.github} target="_blank" rel="noopener" class="underline decoration-ink/30 underline-offset-4 hover:decoration-accent">GitHub</a>{copy.onGithub[1]}
        </p>
      </div>
    </article>

    <aside class="self-start border border-ink bg-paper md:col-span-5 md:mx-3">
      <p class="flex items-center gap-2 border-b border-ink px-3 py-1.5 font-mono text-xs">
        <FileBadge type="csv" aria-hidden="true" />
        {copy.credentials}
      </p>
      <table class="w-full text-left">
        <thead>
          <tr class="bg-ink/5 font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
            <th scope="col" class="border-r border-ink/15 px-3 py-1.5 font-normal">{copy.columns[0]}</th>
            <th scope="col" class="px-3 py-1.5 font-normal">{copy.columns[1]}</th>
          </tr>
        </thead>
        <tbody>
          {
            credentials.map(({ title, place, when }) => (
              <tr class="border-t border-ink/15 align-top">
                <th scope="row" class="border-r border-ink/15 px-3 py-2 font-normal">
                  <span class="block text-[15px] font-medium">{title}</span>
                  <span class="block font-mono text-xs text-muted">{place}</span>
                </th>
                <td class="whitespace-nowrap px-3 py-2 font-mono text-[13px] tabular-nums">{when}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </aside>
  </div>
</section>
