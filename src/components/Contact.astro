---
import SectionLabel from './SectionLabel.astro';
import { profile } from '../data/cv';

interface Props {
  index: string;
}

const { index } = Astro.props;

// A real vCard, so "save contact" is one tap on a phone. No phone number: the
// site has never published one.
const vcard = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  'N:León Castro;Gabriel;;;',
  `FN:${profile.name}`,
  `TITLE:${profile.role}`,
  `EMAIL;TYPE=INTERNET:${profile.email}`,
  `URL:${profile.links.linkedin}`,
  'ADR;TYPE=WORK:;;;San José;;;Costa Rica',
  'END:VCARD',
].join('\r\n');
const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcard)}`;

const year = new Date().getFullYear();
const button = 'flex items-center gap-1.5 border border-ink px-3 py-1.5 transition-colors hover:bg-ink hover:text-paper';
---

<section
  id="contact"
  data-cell
  data-formula={`=HYPERLINK("mailto:${profile.email}")`}
  class="px-4 pb-[var(--row)] pt-[calc(var(--row)*2)] md:px-0">
  <div class="md:px-3">
    <SectionLabel index={index} type="md" file="contact" />
  </div>

  <div class="mt-[var(--row)] md:px-3">
    <a
      href={`mailto:${profile.email}`}
      class="inline-block break-all font-pixel text-[22px] leading-tight decoration-accent decoration-4 underline-offset-[0.2em] hover:underline sm:text-[33px] md:text-[44px] lg:text-[55px]">
      {profile.email}
    </a>

    <p class="mt-4 max-w-[52ch] text-[1.125rem] leading-snug md:text-[1.25rem]">
      Open to remote analytics engineering roles. San José, Costa Rica, UTC−6.
    </p>

    <div class="mt-[var(--row)] flex flex-wrap gap-2 font-mono text-xs">
      <button type="button" data-copy={profile.email} class:list={['js-only', button]}>Copy email</button>
      <a href={profile.links.linkedin} target="_blank" rel="noopener" class={button}>LinkedIn <span aria-hidden="true">↗</span></a>
      <a href={profile.links.github} target="_blank" rel="noopener" class={button}>GitHub <span aria-hidden="true">↗</span></a>
      <a href="/cv" class={button}>CV</a>
      <a href={vcardHref} download="gabriel_leon_castro.vcf" class={button}><span aria-hidden="true">↓</span> contact.vcf</a>
    </div>
  </div>

  <p class="mt-[calc(var(--row)*3)] flex flex-wrap gap-x-4 gap-y-1 border-t border-ink/20 pt-3 font-mono text-[11px] text-muted md:px-3">
    <span>© {year} {profile.name}</span>
    <span>Set in Departure Mono, Schibsted Grotesk and IBM Plex Mono</span>
    <a href="https://github.com/Gaboelc/Portfolio-Gaboelc" target="_blank" rel="noopener" class="hover:text-ink">
      Source <span aria-hidden="true">↗</span>
    </a>
  </p>
</section>
