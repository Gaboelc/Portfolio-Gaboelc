---
const year = new Date().getFullYear();

const links = [
  { href: '#About', label: 'About' },
  { href: '#Experience', label: 'Experience' },
  { href: '#Skills', label: 'Skills' },
  { href: '#Education', label: 'Education' },
  { href: '#Contact', label: 'Contact' },
];
---

<footer class="w-full border-t border-white/5 mt-8">
  <div
    class="max-w-screen-lg mx-auto px-4 md:px-6 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <span class="text-sm text-gray-400 text-center md:text-left">
      © {year}
      <a
        href="https://www.linkedin.com/in/gaboelc/"
        target="_blank"
        rel="noopener"
        class="hover:text-[#FC6D09] transition-colors duration-200">Gabriel León Castro</a>
    </span>

    <nav>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-gray-400">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} class="hover:text-[#FC6D09] transition-colors duration-200">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
