---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Headling from '../components/Headling.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---
<MainLayout title="Gabriel León Castro — Analytics Engineer">
  <!-- Every section spans the same width so the left edge never moves as you
       scroll. Rhythm comes from vertical spacing and from the reading measure
       set inside each component, not from centring blocks of differing widths. -->
  <section class="w-full pt-6 pb-14 md:pt-10 md:pb-20">
    <Headling />
  </section>

  <section id="About" class="w-full py-12 md:py-16" data-reveal>
    <About />
  </section>

  <section id="Experience" class="w-full py-12 md:py-16" data-reveal>
    <Experience />
  </section>

  <section id="Projects" class="w-full py-12 md:py-16" data-reveal>
    <Projects />
  </section>

  <section id="Skills" class="w-full py-12 md:py-16" data-reveal>
    <Skills />
  </section>

  <section id="Education" class="w-full py-12 md:py-16" data-reveal>
    <Education />
  </section>

  <section id="Contact" class="w-full py-12 md:py-16" data-reveal>
    <Contact />
  </section>
</MainLayout>
