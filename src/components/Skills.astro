---
import Tittle from "./Tittle.astro";
import { skillGroups, alsoFamiliar } from "../data/cv";

import SQLIcon from "../icons/SQLIcon.astro";
import PythonIcon from "../icons/PythonIcon.astro";
import PowerBIIcon from "../icons/PowerBIIcon.astro";
import TableauIcon from "../icons/TableauIcon.astro";
import SnowflakeIcon from "../icons/SnowflakeIcon.astro";
import ETLIcon from "../icons/ETLIcon.astro";
import DataModelingIcon from "../icons/DataModelingIcon.astro";
import DataWarehouseIcon from "../icons/DataWarehouseIcon.astro";
import PandasIcon from "../icons/PandasIcon.astro";
import NumpyIcon from "../icons/NumpyIcon.astro";
import PostgreSQLIcon from "../icons/PostgreSQLIcon.astro";
import MongoDBIcon from "../icons/MongoBDIcon.astro";
import ExcelIcon from "../icons/ExcelIcon.astro";
import PowerAppsIcon from "../icons/PowerAppsIcon.astro";
import PowerAutomateIcon from "../icons/PowerAutomateIcon.astro";
import RLanguageIcon from "../icons/RLanguageIcon.astro";
import TensorFlowIcon from "../icons/TensorFlowIcon.astro";
import ScikitLearnIcon from "../icons/ScikitLearnIcon.astro";
import StreamlitIcon from "../icons/StreamlitIcon.astro";
import AzureIcon from "../icons/AzureIcon.astro";
import AWSIcon from "../icons/AWSIcon.astro";
import HadoopIcon from "../icons/HadoopIcon.astro";
import SparkIcon from "../icons/SparkIcon.astro";

// Skill names live in src/data/cv.ts so the printable CV shares them; the icon
// for each name is presentation, so the mapping stays here.
const icons: Record<string, any> = {
  SQL: SQLIcon,
  Python: PythonIcon,
  "Power BI": PowerBIIcon,
  Tableau: TableauIcon,
  Snowflake: SnowflakeIcon,
  "ETL / ELT": ETLIcon,
  "Data Modeling": DataModelingIcon,
  "Data Warehousing": DataWarehouseIcon,
  Pandas: PandasIcon,
  NumPy: NumpyIcon,
  "SQL Databases": PostgreSQLIcon,
  "NoSQL Databases": MongoDBIcon,
  "Excel (Advanced)": ExcelIcon,
  "Power Apps": PowerAppsIcon,
  "Power Automate": PowerAutomateIcon,
  "R Language": RLanguageIcon,
  TensorFlow: TensorFlowIcon,
  "Scikit-Learn": ScikitLearnIcon,
  Streamlit: StreamlitIcon,
  Azure: AzureIcon,
  AWS: AWSIcon,
  "Apache Hadoop": HadoopIcon,
  "Apache Spark": SparkIcon,
};
---

<Tittle title="Skills" />

{/* Columns rather than a grid: the groups hold 5, 3, 2, 2, 3 and 8 items, so
    rows would always leave dead space under the shorter cards. Flowing them
    down columns lets each card take only the height it needs. */}
<div class="columns-1 md:columns-2 lg:columns-3 gap-6 text-white mt-8">
  {
    skillGroups.map(({ title, items }) => (
      <div class="break-inside-avoid mb-6 bg-white/5 border border-white/10 rounded-lg p-6 text-center transition-colors duration-300 hover:border-accent/40">
        <h3 class="mb-4 font-bold text-gray-200">{title}</h3>
        <div class="flex flex-col gap-4">
          {items.map((name) => {
            const Icon = icons[name];
            return (
              <div class="flex items-center gap-2">
                {Icon && <Icon class="w-6 h-6 flex-shrink-0" />}
                <span>{name}</span>
              </div>
            );
          })}
        </div>
      </div>
    ))
  }

  <div class="break-inside-avoid mb-6 bg-white/[0.02] border border-white/5 rounded-lg p-6 text-center">
    <h3 class="mb-4 font-bold text-gray-400">Also familiar with</h3>
    <div class="flex flex-wrap justify-center gap-2">
      {
        alsoFamiliar.map((name) => {
          const Icon = icons[name];
          return (
            <span class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 py-1.5 px-3 text-sm text-gray-300">
              {Icon && <Icon class="w-4 h-4 flex-shrink-0" />}
              {name}
            </span>
          );
        })
      }
    </div>
  </div>
</div>
