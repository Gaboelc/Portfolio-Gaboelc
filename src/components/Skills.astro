---
import Tittle from "./Tittle.astro";
import SQLIcon from "../icons/SQLIcon.astro";
import PythonIcon from "../icons/PythonIcon.astro";
import PowerBIIcon from "../icons/PowerBIIcon.astro";
import TableauIcon from "../icons/TableauIcon.astro";
import SnowflakeIcon from "../icons/SnowflakeIcon.astro";
import ETLIcon from "../icons/ETLIcon.astro";
import DataModelingIcon from "../icons/DataModelingIcon.astro";
import DataWarehouseIcon from "../icons/DataWarehouseIcon.astro";
import PandasIcon from "../icons/PandasIcon.astro";
import NumpyIcon from "../icons/NumpyIcon.astro";
import PostgreSQLIcon from "../icons/PostgreSQLIcon.astro";
import MongoDBIcon from "../icons/MongoBDIcon.astro";
import ExcelIcon from "../icons/ExcelIcon.astro";
import PowerAppsIcon from "../icons/PowerAppsIcon.astro";
import PowerAutomateIcon from "../icons/PowerAutomateIcon.astro";
import RLanguageIcon from "../icons/RLanguageIcon.astro";
import TensorFlowIcon from "../icons/TensorFlowIcon.astro";
import ScikitLearnIcon from "../icons/ScikitLearnIcon.astro";
import StreamlitIcon from "../icons/StreamlitIcon.astro";
import AzureIcon from "../icons/AzureIcon.astro";
import AWSIcon from "../icons/AWSIcon.astro";
import HadoopIcon from "../icons/HadoopIcon.astro";
import SparkIcon from "../icons/SparkIcon.astro";

const groups = [
  {
    title: "Data & Analytics",
    items: [
      { name: "SQL", Icon: SQLIcon },
      { name: "Python", Icon: PythonIcon },
      { name: "Power BI", Icon: PowerBIIcon },
      { name: "Tableau", Icon: TableauIcon },
      { name: "Snowflake", Icon: SnowflakeIcon },
    ],
  },
  {
    title: "Data Engineering",
    items: [
      { name: "ETL / ELT", Icon: ETLIcon },
      { name: "Data Modeling", Icon: DataModelingIcon },
      { name: "Data Warehousing", Icon: DataWarehouseIcon },
    ],
  },
  {
    title: "Programming & Libraries",
    items: [
      { name: "Pandas", Icon: PandasIcon },
      { name: "NumPy", Icon: NumpyIcon },
    ],
  },
  {
    title: "Databases",
    items: [
      { name: "SQL Databases", Icon: PostgreSQLIcon },
      { name: "NoSQL Databases", Icon: MongoDBIcon },
    ],
  },
  {
    title: "Tools & Productivity",
    items: [
      { name: "Excel (Advanced)", Icon: ExcelIcon },
      { name: "Power Apps", Icon: PowerAppsIcon },
      { name: "Power Automate", Icon: PowerAutomateIcon },
    ],
  },
];

const alsoFamiliar = [
  { name: "R Language", Icon: RLanguageIcon },
  { name: "TensorFlow", Icon: TensorFlowIcon },
  { name: "Scikit-Learn", Icon: ScikitLearnIcon },
  { name: "Streamlit", Icon: StreamlitIcon },
  { name: "Azure", Icon: AzureIcon },
  { name: "AWS", Icon: AWSIcon },
  { name: "Apache Hadoop", Icon: HadoopIcon },
  { name: "Apache Spark", Icon: SparkIcon },
];
---

<Tittle title="Skills" />

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 text-white mt-8">
  {
    groups.map(({ title, items }) => (
      <div class="bg-white/5 border border-white/10 rounded-lg p-6 text-center transition-colors duration-300 hover:border-[#FC6D09]/40">
        <h3 class="mb-4 font-bold text-gray-200">{title}</h3>
        <div class="flex flex-col gap-4">
          {items.map(({ name, Icon }) => (
            <div class="flex items-center gap-2">
              <Icon class="w-6 h-6 flex-shrink-0" />
              <span>{name}</span>
            </div>
          ))}
        </div>
      </div>
    ))
  }

  <div class="bg-white/[0.02] border border-white/5 rounded-lg p-6 text-center md:col-span-2 lg:col-span-1">
    <h3 class="mb-4 font-bold text-gray-400">Also familiar with</h3>
    <div class="flex flex-wrap justify-center gap-2">
      {
        alsoFamiliar.map(({ name, Icon }) => (
          <span class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 py-1.5 px-3 text-sm text-gray-300">
            <Icon class="w-4 h-4 flex-shrink-0" />
            {name}
          </span>
        ))
      }
    </div>
  </div>
</div>
