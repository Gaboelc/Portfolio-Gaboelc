---
import MainLayout from '../layouts/MainLayout.astro';
import Tittle from '../components/Tittle.astro';
import SocialPill from '../components/SocialPill.astro';
import CVIcon from '../icons/CVIcon.astro';

const destinations = [
  { href: '/#Projects', label: 'Projects' },
  { href: '/#Experience', label: 'Experience' },
  { href: '/#Contact', label: 'Contact' },
];
---

<MainLayout
  title="Page not found - Gabriel León Castro"
  description="That page does not exist. Head back to the portfolio of Gabriel León Castro, Analytics Engineer."
  noindex>
  <section class="w-full mx-auto lg:w-[700px] py-24 md:py-32 text-center">
    <p class="text-7xl md:text-8xl font-extrabold text-accent leading-none">404</p>

    <Tittle as="h1" title="This page doesn't exist" />

    <p class="max-w-lg mx-auto text-base md:text-lg text-gray-400 leading-relaxed">
      The link is either out of date or slightly mistyped. Nothing is broken on
      your end.
    </p>

    <nav class="flex flex-wrap justify-center gap-3 mt-8">
      {
        destinations.map(({ href, label }) => (
          <a
            href={href}
            class="rounded-full border border-white/10 bg-white/5 py-2 px-5 text-sm md:text-base text-gray-300 transition-colors duration-300 hover:border-accent/40 hover:text-white">
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex justify-center mt-8">
      <SocialPill href="/" target="_self">
        <CVIcon class="w-5 h-5 md:w-6 md:h-6" />
        Back to the portfolio
      </SocialPill>
    </div>
  </section>
</MainLayout>
