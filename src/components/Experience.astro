---
import Tittle from "./Tittle.astro";
import { experience } from "../data/cv";
---

<div class="container mx-auto px-4 mt-8 md:mt-12">
  <Tittle title="Experience" />

  <ol class="relative border-l border-white/10 ml-4 md:ml-8">
    {
      experience.map(({ period, role, company, location, highlights }) => (
        <li class="mb-10 pl-6">
          <div class="absolute w-3 h-3 bg-accent rounded-full mt-2 -left-1.5 ring-4 ring-ink" />
          <time class="mb-1 text-sm font-normal leading-none text-gray-400">
            {period} · {location}
          </time>
          <h3 class="text-lg md:text-xl font-semibold text-white">
            {role} @ <span class="text-accent">{company}</span>
          </h3>
          <ul class="max-w-md space-y-2 mt-2 text-sm md:text-base text-gray-400 list-inside">
            {highlights.map((highlight) => (
              <li class="flex items-baseline">
                <svg
                  class="w-4 h-4 mr-2 text-green-400 flex-shrink-0"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                </svg>
                {highlight}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</div>
