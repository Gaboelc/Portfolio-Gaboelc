---
// Self-hosted fonts: no render-blocking request to a third-party CDN. The pixel
// display face is declared in global.css and preloaded below, since the hero
// name is set in it.
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import SheetBar from '../components/SheetBar.astro';
import SheetFrame from '../components/SheetFrame.astro';
import SheetTabs from '../components/SheetTabs.astro';
import '../../styles/global.css';
import { profile, education, certifications, skillGroups, languages } from '../data/cv';
import { t, langOf, pathIn, langs } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Keeps a page out of search results. Only the 404 needs it. */
  noindex?: boolean;
}

const lang = langOf(Astro.url);

const defaults = {
  en: 'Analytics engineer in San José, Costa Rica. 6+ years between the warehouse and the business: SQL in Snowflake and Redshift, star-schema semantic models and Power BI.',
  es: 'Analytics engineer en San José, Costa Rica. Más de 6 años entre el warehouse y el negocio: SQL en Snowflake y Redshift, modelos semánticos en esquema estrella y Power BI.',
};

const { title, description = defaults[lang], noindex = false } = Astro.props;

const siteUrl = Astro.site!.href;
const ogImage = new URL('/images/og-image.png', siteUrl).href;

// Per page, not per site. These were hardcoded to the home page, which told
// search engines that /cv was a duplicate of / and should not be indexed.
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// The same page in each language, so search engines serve the right one.
const alternates = langs.map((code) => ({ code, href: new URL(pathIn(code, Astro.url), siteUrl).href }));
const ogLocale = { en: 'en_US', es: 'es_LA' };

// Structured data, built from the same CV source as the pages themselves so it
// cannot drift. Tells search engines this is a person, what they do, and which
// profiles are the same individual.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: t(profile.summary, lang),
  url: new URL(pathIn(lang, new URL('/', siteUrl)), siteUrl).href,
  image: new URL('/images/gabriel-576.webp', siteUrl).href,
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San José',
    addressCountry: 'CR',
  },
  sameAs: [profile.links.linkedin, profile.links.github],
  alumniOf: education.map((entry) => ({
    '@type': 'EducationalOrganization',
    name: entry.place,
  })),
  hasCredential: certifications.map((entry) => ({
    '@type': 'EducationalOccupationalCredential',
    name: entry.title,
    credentialCategory: 'certification',
    recognizedBy: { '@type': 'Organization', name: entry.place },
  })),
  knowsAbout: skillGroups.flatMap((group) => group.items.map(({ name }) => t(name, lang))),
  knowsLanguage: languages.map(({ code }) => code),
};
---

<html lang={lang}>
  <head>
    <!-- Marks that scripting is available, so the reveal animation can hide
         elements without risking permanently invisible content. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#F2F2F2">
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Gabriel León Castro">
    <link rel="canonical" href={canonical}>
    {!noindex && alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.webp">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.webp">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Gabriel León Castro">
    <meta property="og:locale" content={ogLocale[lang]}>
    <meta property="og:locale:alternate" content={ogLocale[lang === 'en' ? 'es' : 'en']}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Gabriel León Castro — Analytics Engineer">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline></script>
  </head>

  <body class="flex min-h-screen flex-col font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>

    <SheetBar />

    <SheetFrame>
      <slot />
    </SheetFrame>

    <SheetTabs />

    <script>
      // Copy buttons ([data-copy]) put their value on the clipboard and say so
      // where the button was, in the page's language (data-copied, data-failed).
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        const label = button.textContent;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = button.dataset.copied ?? 'Copied';
          } catch {
            button.textContent = button.dataset.failed ?? 'Press ⌘/Ctrl+C';
          }
          setTimeout(() => (button.textContent = label), 1600);
        });
      });
    </script>

    <script>
      // Reveal-on-scroll, which grows the chart bars. Hiding anything behind an
      // animation means every failure mode has to end with the content visible, so there are three
      // guards: the .js class set in <head> covers this script never loading,
      // the reduced-motion branch covers the preference, and the timeout below
      // covers the observer loading but never delivering.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const revealAll = () => items.forEach((el) => el.classList.add('is-revealed'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        let delivered = false;

        const observer = new IntersectionObserver(
          (entries) => {
            delivered = true;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          // threshold 0 rather than a fraction: sections taller than the
          // viewport can never expose a large share of their own area.
          { rootMargin: '0px 0px -10% 0px', threshold: 0 }
        );

        items.forEach((el) => observer.observe(el));

        // An observer delivers an initial entry for every element it is given,
        // intersecting or not. Silence means it is not running at all.
        setTimeout(() => {
          if (delivered) return;
          observer.disconnect();
          revealAll();
        }, 1200);
      }
    </script>
  </body>
</html>
