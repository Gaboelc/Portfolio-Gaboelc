---
import SectionLabel from './SectionLabel.astro';
import FileBadge, { type FileType } from './FileBadge.astro';
import BarCompare from './BarCompare.astro';
import { projects, type Project } from '../data/cv';

interface Props {
  index: string;
}

const { index } = Astro.props;

// Each case is a "report page": a header strip like a window title, the
// headline figure and its chart on the left, problem / approach / outcome as
// numbered notes on the right. Older work collapses to a single row at the end.
const main = projects.filter((p) => !p.earlier);
const earlier = projects.filter((p) => p.earlier);

const parts = [
  { key: 'problem', label: 'Problem' },
  { key: 'approach', label: 'What I did' },
  { key: 'outcome', label: 'Outcome' },
] as const;

const typeOf = (file: string) => file.split('.').pop() as FileType;
const byline = (p: Project) => [p.client ? `${p.client} (${p.company.split(',')[0]})` : p.company, p.period].join(' · ');
---

<section
  id="cases"
  data-cell
  data-formula={'=FILTER(work, outcome <> "")'}
  class="px-4 py-[calc(var(--row)*2)] md:px-0">
  <div class="md:px-3">
    <SectionLabel index={index} type="md" file="cases/" />
  </div>

  <p class="mt-[var(--row)] max-w-[44ch] text-[1.375rem] leading-[1.3] md:px-3 md:text-[1.625rem]">
    Client work stays under NDA, so it's written up instead of shown: what was
    wrong, what I changed, and what it measured afterwards.
  </p>

  <ol class="mt-[var(--row)] flex flex-col gap-[var(--row)] md:px-3">
    {
      main.map((project, i) => (
        <li>
          <article class="border border-ink bg-paper">
            <header class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-ink px-3 py-1.5 font-mono text-xs">
              <span class="font-pixel text-[11px]">{index}.{i + 1}</span>
              <FileBadge type={typeOf(project.file)} aria-hidden="true" />
              <span>{project.file}</span>
              <span class="ml-auto text-muted">{byline(project)}</span>
            </header>

            <div class="grid gap-[var(--row)] p-4 md:grid-cols-12 md:gap-x-8 md:p-6">
              <div class="md:col-span-5">
                <h3 class="text-[1.75rem] font-medium leading-[1.1] tracking-[-0.01em] md:text-[2.25rem]">
                  {project.title}
                </h3>

                {project.metric && (
                  <p class="mt-[var(--row)]">
                    <span class="block font-pixel text-[33px] leading-none sm:text-[44px]">{project.metric.value}</span>
                    <span class="mt-1 block font-mono text-xs text-muted">{project.metric.label}</span>
                  </p>
                )}

                {project.chart && (
                  <div class="mt-[var(--row)]">
                    <BarCompare chart={project.chart} caption={project.metric?.label ?? project.title} />
                  </div>
                )}
              </div>

              <dl class="flex flex-col gap-5 md:col-span-7">
                {parts.map(({ key, label }, n) => (
                  <div>
                    <dt class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-muted">
                      <span class="inline-flex h-4 w-4 items-center justify-center border border-ink/40 font-pixel text-[11px] normal-case tracking-normal text-ink">
                        {n + 1}
                      </span>
                      {label}
                    </dt>
                    <dd class="mt-1.5 max-w-[68ch] text-[15px] leading-relaxed md:text-base">{project[key]}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <p class="border-t border-ink/15 px-3 py-2 font-mono text-xs md:px-6">
              <span class="text-muted">stack:</span> {project.stack.join(' · ')}
            </p>
          </article>
        </li>
      ))
    }
  </ol>

  {
    earlier.length > 0 && (
      <div class="mt-[var(--row)] md:px-3">
        <p class="mb-2 font-mono text-xs text-muted">earlier/</p>
        <div class="border border-ink bg-paper">
          {earlier.map((project, i) => (
            <details class="group border-b border-ink/15 last:border-b-0">
              <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2 font-mono text-xs transition-colors hover:bg-ink/[0.03] [&::-webkit-details-marker]:hidden">
                <span class="font-pixel text-[11px]">{index}.{main.length + i + 1}</span>
                <FileBadge type={typeOf(project.file)} aria-hidden="true" />
                <span class="font-sans text-[15px] font-medium">{project.title}</span>
                <span class="text-muted">{byline(project)}</span>
                {project.metric && <span class="ml-auto">{project.metric.value} {project.metric.label}</span>}
                <svg class="h-3 w-3 shrink-0 text-muted transition-transform group-open:rotate-180" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </summary>
              <div class="grid gap-[var(--row)] border-t border-dashed border-ink/20 p-4 md:grid-cols-12 md:gap-x-8 md:p-6">
                <div class="md:col-span-5">
                  {project.chart && <BarCompare chart={project.chart} caption={project.metric?.label ?? project.title} />}
                </div>
                <dl class="flex flex-col gap-4 md:col-span-7">
                  {parts.map(({ key, label }) => (
                    <div>
                      <dt class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">{label}</dt>
                      <dd class="mt-1 max-w-[68ch] text-[15px] leading-relaxed">{project[key]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </details>
          ))}
        </div>
      </div>
    )
  }
</section>
