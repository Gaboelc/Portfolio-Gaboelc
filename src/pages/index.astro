---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Headling from '../components/Headling.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---
<MainLayout title="Gabriel León Castro - Analytics Engineer Portfolio">
  <!-- Widths and spacing vary on purpose: prose gets a narrow measure, the
       case studies get the full column, and the rest sits between. Uniform
       sections scroll like a form. -->
  <section class="w-full pt-8 pb-20 md:pt-14 md:pb-28">
    <Headling />
  </section>

  <section id="About" class="w-full mx-auto lg:w-[700px] py-14 md:py-20" data-reveal>
    <About />
  </section>

  <section id="Experience" class="w-full mx-auto lg:w-[850px] py-14 md:py-20" data-reveal>
    <Experience />
  </section>

  <section id="Projects" class="w-full py-14 md:py-20" data-reveal>
    <Projects />
  </section>

  <section id="Skills" class="w-full mx-auto lg:w-[850px] py-14 md:py-20" data-reveal>
    <Skills />
  </section>

  <section id="Education" class="w-full mx-auto lg:w-[850px] py-14 md:py-20" data-reveal>
    <Education />
  </section>

  <section id="Contact" class="w-full mx-auto lg:w-[700px] py-14 md:py-20" data-reveal>
    <Contact />
  </section>
</MainLayout>
