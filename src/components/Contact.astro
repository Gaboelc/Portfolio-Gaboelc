---
import Tittle from "./Tittle.astro";
import EmailIcon from "../icons/EmailIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import GitHubIcon from "../icons/GitHubIcon.astro";

const channels = [
  {
    href: "mailto:gabrielleon917@gmail.com",
    label: "Email",
    Icon: EmailIcon,
    classes: "bg-gray-700 hover:bg-gray-600",
    external: false,
  },
  {
    href: "https://www.linkedin.com/in/gaboelc/",
    label: "LinkedIn",
    Icon: LinkedInIcon,
    classes: "bg-blue-700 hover:bg-blue-600",
    external: true,
  },
  {
    href: "https://github.com/Gaboelc",
    label: "GitHub",
    Icon: GitHubIcon,
    classes: "bg-gray-900 hover:bg-gray-800",
    external: true,
  },
];
---

<div class="container mx-auto px-4 mt-8 md:mt-12 text-center">
  <Tittle title="Connect With Me" />

  <div class="flex flex-wrap justify-center gap-6 md:gap-8 mt-8">
    {
      channels.map(({ href, label, Icon, classes, external }) => (
        <a
          href={href}
          aria-label={label}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener" : undefined}
          class:list={[
            "group flex flex-col items-center justify-center gap-2 w-24 h-24 md:w-28 md:h-28 rounded-lg shadow-lg text-white transition-all duration-300 hover:scale-105",
            classes,
          ]}>
          <Icon class="w-8 h-8 md:w-9 md:h-9" />
          <span class="text-xs md:text-sm text-gray-300 group-hover:text-white">
            {label}
          </span>
        </a>
      ))
    }
  </div>
</div>
