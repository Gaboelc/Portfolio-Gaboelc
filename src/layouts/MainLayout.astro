---
// Self-hosted fonts: no render-blocking request to a third-party CDN.
// Rajdhani carries body copy, Roboto the headings — both need real bold
// weights so the browser never has to synthesise them.
import '@fontsource/rajdhani/400.css';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/roboto/600.css';
import '@fontsource/roboto/700.css';
import '@fontsource/roboto/800.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Analytics Engineer with 5+ years building scalable data models, semantic layers, and BI solutions on Snowflake, Power BI and SQL-based ELT.',
} = Astro.props;

const siteUrl = 'https://www.gaboelc.dev/';
const ogImage = new URL('/images/og-image.png', siteUrl).href;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Gabriel León Castro">
    <link rel="canonical" href={siteUrl}>

    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.webp">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.webp">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Gabriel León Castro">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={siteUrl}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Gabriel León Castro — Analytics Engineer">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
  </head>

  <body class="min-h-screen flex flex-col">
    <div
      class="fixed inset-0 -z-10 bg-[#020617] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(109,120,99,0.4),rgba(242,242,242,0))]"
      aria-hidden="true">
    </div>

    <Header />

    <main class="flex-1 w-full max-w-screen-lg mx-auto px-4 md:px-6">
      <slot />
    </main>

    <Footer />
  </body>
</html>
