---
interface Props {
  title: string;
  as?: 'h1' | 'h2';
}

const { title, as: Tag = 'h2' } = Astro.props;

const sizes = {
  h1: 'text-4xl md:text-5xl lg:text-6xl',
  h2: 'text-3xl md:text-4xl',
};
---

<Tag
  class:list={[
    'text-gray-200 font-extrabold tracking-tight leading-none pt-2 pb-4',
    sizes[Tag],
  ]}>
  {title}
</Tag>
